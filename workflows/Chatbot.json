    {
      "parameters": {
        "jsCode": "// 1. Obtener los IDs de Drive (La Verdad Global)\n// Usamos $('NombreDelNodoDrive').all() para leer datos fuera del bucle\nconst driveFiles = $('Get all files').all();\nconst driveIds = new Set(driveFiles.map(file => file.json.id));\n\n// 2. Obtener los puntos de ESTE lote de Qdrant\nconst points = $input.first().json.result.points;\nconst nextOffset = $input.first().json.result.next_page_offset;\n\n// 3. Buscar Huérfanos en este lote\nconst idsToDelete = [];\npoints.forEach(point => {\n  if (point.payload) {\n    const fileId = point.payload.metadata.file_id;\n    if(fileId && !idsToDelete.find(id => id == fileId)){\n      if (!driveIds.has(fileId)) {\n        // Si no está en Drive, se marca para borrar\n        idsToDelete.push(fileId);\n      }\n    }\n  }\n});\n\n// 4. Retornar estructura para los siguientes pasos\nreturn {\n  json: {\n    ids_to_delete: idsToDelete,\n    next_offset: nextOffset\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        576

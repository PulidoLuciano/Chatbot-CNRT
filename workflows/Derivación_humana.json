    {
      "parameters": {
        "jsCode": "if(!items[0]) return { history: [] };\nconst raw = items[0].json.history_raw;\nlet messages = [];\n\ntry {\n  if (Array.isArray(raw)) {\n    messages = raw.map(m => {\n      const parsed = JSON.parse(m)\n      return {\n      type: parsed.type === 'human' ? 'user' : parsed.type, // Adaptar según tu data\n      data: {\n        content: parsed.data.content || parsed.text\n      }\n    }});\n    messages.reverse()\n  }\n} catch (e) {\n  messages.push({ role: 'system', content: e });\n}\n\nreturn { history: messages };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

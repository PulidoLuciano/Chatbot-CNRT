    {
      "parameters": {
        "jsCode": "const sessionId = $('Dashboard request').item.json.body.sessionId;\nconst text = $('Dashboard request').item.json.body.text;\n\nlet channel = 'unknown';\nlet cleanId = sessionId;\n\nif (sessionId.startsWith('telegram_')) {\n  channel = 'telegram';\n  cleanId = sessionId.replace('telegram_', '');\n} else if (sessionId.startsWith('web_')) {\n  channel = 'web';\n}\n\nreturn { json: { channel, cleanId, text, sessionId } };"
      },

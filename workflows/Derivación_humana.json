      "parameters": {
        "jsCode": "const keys = Object.keys(items[0].json).length > 0 ? items[0].json : [];\n\nlet keysArray = Array.isArray(keys) ? keys : Object.keys(keys);\n\nconst users = keysArray\n  .filter(k => k.startsWith('queue:'))\n  .map(k => k.replace('queue:', ''));\n\nreturn { sessions: users };"
